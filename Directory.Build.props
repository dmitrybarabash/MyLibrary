<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>

    <Product>MyLibrary</Product>
    <Authors>Dmitry Barabash</Authors>
    <Company>Dmitry Barabash's Software Company</Company>
    <Description>MyLibrary Demo Project</Description>
    <Copyright>Copyright (c) 2015-2026 Dmitry Barabash</Copyright>
    <NeutralLanguage>ru</NeutralLanguage>

    <ApplicationIcon>$(MSBuildThisFileDirectory)assets\MyLibrary.ico</ApplicationIcon>

    <Version>1.1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <IsPackable>false</IsPackable>

    <UserSecretsId>UserSecrets-For-MyLibrary</UserSecretsId>
  </PropertyGroup>

  <PropertyGroup>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
  </PropertyGroup>

</Project>
