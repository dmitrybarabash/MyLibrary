<Window x:Class="MyLibrary.Wpf.Common.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behaviors="clr-namespace:MyLibrary.Wpf.Common.Behaviors"
        xmlns:viewModels="clr-namespace:MyLibrary.Wpf.Common.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel}"
        Title="MyLibrary"
        Width="1100" Height="650" MinWidth="600" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        behaviors:LoadedBehavior.Command="{Binding LoadedCommand}">
    <Window.Resources>
        <ResourceDictionary Source="Styles.xaml"/>
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="Close" Executed="CloseCommand_Executed"/>
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Gesture="Alt+X" Command="Close"/>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding AddBookCommand}"/>
        <KeyBinding Gesture="Ctrl+E" Command="{Binding EditBookCommand}"/>
        <KeyBinding Gesture="Ctrl+D" Command="{Binding DeleteBookCommand}"/>
    </Window.InputBindings>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Файл">
                <MenuItem Header="В_ыход" Command="Close" InputGestureText="Alt+X"/>
            </MenuItem>
            <MenuItem Header="_Книги">
                <MenuItem Header="_Добавить..." Command="{Binding AddBookCommand}" InputGestureText="Ctrl+N"/>
                <MenuItem Header="_Изменить..." Command="{Binding EditBookCommand}" InputGestureText="Ctrl+E"/>
                <MenuItem Header="_Удалить..." Command="{Binding DeleteBookCommand}" InputGestureText="Ctrl+D"/>
            </MenuItem>
            <MenuItem Header="_Справочники">
                <MenuItem Header="_Авторы" Command="{Binding EditAuthorsCommand}"/>
                <MenuItem Header="_Издательства" Command="{Binding EditPressesCommand}"/>
            </MenuItem>
            <MenuItem Header="_?">
                <MenuItem Header="О программе" Click="MenuItemAbout_Click"/>
            </MenuItem>
        </Menu>
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ListView Grid.Column="0"
                      ItemsSource="{Binding Books}"
                      SelectionMode="Extended"
                      ItemContainerStyle="{StaticResource ListViewItemStyle}"
                      behaviors:SelectedItemsBehavior.SelectedItems="{Binding SelectedBooks}"
                      behaviors:ItemDoubleClickBehavior.Command="{Binding EditBookCommand}"
                      behaviors:GridViewColumnsBehavior.WidthProportions="20 45 10 10 15">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Автор" DisplayMemberBinding="{Binding Author}"/>
                        <GridViewColumn Header="Название" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="Страницы">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Pages}" TextAlignment="Right"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Цена">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Price}" TextAlignment="Right"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Издательство" DisplayMemberBinding="{Binding Press}"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <Button Content="Добавить" Command="{Binding AddBookCommand}" Style="{StaticResource ListButtonStyle}"/>
                <Button Content="Изменить" Command="{Binding EditBookCommand}" Style="{StaticResource ListButtonStyle}"/>
                <Button Content="Удалить" Command="{Binding DeleteBookCommand}" Style="{StaticResource ListButtonStyle}"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
