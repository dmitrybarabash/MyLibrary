<!--
    Стили, общие для всех окон приложения
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Кнопки управления списком (Добавить, Изменить, Удалить, Закрыть) -->
    <Style x:Key="ListButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="100"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- Кнопки подтверждения и отмены диалога (OK, Отмена) -->
    <Style x:Key="DialogButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="100"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>

    <!-- Строки списков. Растягиваем содержимое ячеек на всю ширину столбца, чтобы числа
         можно было выровнять по правому краю. -->
    <Style x:Key="ListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <!-- Подписи к полям ввода диалогов -->
    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,5,15,5"/>
    </Style>

    <!-- Поля ввода диалогов -->
    <Style x:Key="FieldStyle" TargetType="FrameworkElement">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Margin" Value="0,5"/>
    </Style>

</ResourceDictionary>
