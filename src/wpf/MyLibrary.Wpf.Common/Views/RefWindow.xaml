<Window x:Class="MyLibrary.Wpf.Common.Views.RefWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behaviors="clr-namespace:MyLibrary.Wpf.Common.Behaviors"
        xmlns:viewModels="clr-namespace:MyLibrary.Wpf.Common.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:RefViewModel}"
        Title="{Binding Title}"
        Width="500" Height="550"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=listViewItems}"
        behaviors:LoadedBehavior.Command="{Binding LoadedCommand}">
    <Window.Resources>
        <ResourceDictionary Source="Styles.xaml"/>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ListView x:Name="listViewItems"
                  Grid.Column="0"
                  ItemsSource="{Binding Items}"
                  SelectionMode="Extended"
                  ItemContainerStyle="{StaticResource ListViewItemStyle}"
                  behaviors:SelectedItemsBehavior.SelectedItems="{Binding SelectedItems}"
                  behaviors:ItemDoubleClickBehavior.Command="{Binding EditCommand}"
                  behaviors:GridViewColumnsBehavior.WidthProportions="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{Binding ColumnName}" DisplayMemberBinding="{Binding Name}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <DockPanel Grid.Column="1" Margin="12,0,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Top" Content="Добавить" Command="{Binding AddCommand}" Style="{StaticResource ListButtonStyle}"/>
            <Button DockPanel.Dock="Top" Content="Изменить" Command="{Binding EditCommand}" Style="{StaticResource ListButtonStyle}"/>
            <Button DockPanel.Dock="Top" Content="Удалить" Command="{Binding DeleteCommand}" Style="{StaticResource ListButtonStyle}"/>
            <!-- Кнопка закрытия справочника срабатывает и по Enter, и по Esc -->
            <Button DockPanel.Dock="Bottom" Content="Закрыть" IsDefault="True" IsCancel="True" Style="{StaticResource ListButtonStyle}" Margin="0"/>
        </DockPanel>
    </Grid>
</Window>
