<UserControl x:Class="MyLibrary.Wpf.Common.Controls.NumericUpDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="100">
    <UserControl.Resources>
        <Style x:Key="SpinButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="ArrowStyle" TargetType="Path">
            <Setter Property="Fill" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBox x:Name="textBox" Grid.RowSpan="2" VerticalContentAlignment="Center"
                 TextChanged="TextBox_TextChanged" PreviewKeyDown="TextBox_PreviewKeyDown" LostKeyboardFocus="TextBox_LostKeyboardFocus"/>
        <RepeatButton Grid.Column="1" Grid.Row="0" Style="{StaticResource SpinButtonStyle}" Click="ButtonUp_Click">
            <Path Data="M 0,4 L 4,0 L 8,4 Z" Style="{StaticResource ArrowStyle}"/>
        </RepeatButton>
        <RepeatButton Grid.Column="1" Grid.Row="1" Style="{StaticResource SpinButtonStyle}" Click="ButtonDown_Click">
            <Path Data="M 0,0 L 8,0 L 4,4 Z" Style="{StaticResource ArrowStyle}"/>
        </RepeatButton>
    </Grid>
</UserControl>
